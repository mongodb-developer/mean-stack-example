{
  "name": "mean-stack-example",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/mean-stack-example",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "mongodb.mongodb-vscode"
      ]
    }
  },
  "forwardPorts": [
    4200,
    5200,
    27017
  ],
  "portsAttributes": {
    "4200": {
      "label": "Angular Client"
    },
    "5200": {
      "label": "Express API"
    },
    "27017": {
      "label": "MongoDB"
    }
  },
  "postCreateCommand": "npm install",
  "postStartCommand": "bash -lc 'for i in {1..60}; do mongosh --quiet \"$ATLAS_URI\" --eval \"db.hello().isWritablePrimary\" | grep -q true && break; sleep 2; done; npm run seed'",
  "remoteEnv": {
    "ATLAS_URI": "mongodb://localhost:27017/meanStackExample?appName=mean-stack-example-devcontainer"
  }
}
